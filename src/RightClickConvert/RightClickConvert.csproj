<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: as a shell verb this launches on every right-click and Exe
         would flash a console window each time. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.11" />
    <!-- The notifications package pulls System.Drawing.Common 4.7.0 transitively, which
         carries a critical advisory (GHSA-rxg9-xrhp-64gj). Pinned forward to override it. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

</Project>